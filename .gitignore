# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# 抓取产物（每次运行生成，不应入库）
# 用前导 / 只匹配仓库根，避免误伤 examples/ 下的同名示例文件
out/
raw/
/jobs.json
/analysis.json
/career.json
/profile.json

# 登录态 / 浏览器 profile —— 含站点 Cookie 与令牌，绝不可提交
profile/
**/profile/
**/*profile*/
chromium-profile/
.playwright/

# 报告产物
report.html
report.md

# examples/ 是刻意保留的真实案例，需从上面的忽略规则里放行
# （否则 examples/**/career.json 会被 /career.json 之类的规则误伤）
!examples/
!examples/**

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 临时文件
*.log
*.tmp
