# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# 抓取产物（每次运行生成，不应入库）
out/
raw/
jobs.json
analysis.json
career.json
profile.json

# 登录态 / 浏览器 profile —— 含站点 Cookie 与令牌，绝不可提交
profile/
