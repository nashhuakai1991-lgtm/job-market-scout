**/*profile*/
chromium-profile/
.playwright/

# 报告产物（示例目录下的报告是刻意保留的，用 ! 放行）
report.html
report.md
!examples/**/report.html
!examples/**/report.md

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 临时文件
*.log
*.tmp
